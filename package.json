{
  "name": "flow",
  "private": true,
  "version": "0.9.0",
  "type": "module",
  "engines": {
    "node": "20.x"
  },
  "packageManager": "npm@10.9.7",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:quick": "vitest run --changed",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "bench": "vitest run tests/engine/benchmarks --environment node --reporter verbose",
    "bench:timing": "node tests/engine/perf_timing.js",
    "bench:timing:stress": "node tests/engine/perf_timing.js --stress"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.0.0",
    "@supabase/supabase-js": "^2.45.0",
    "@xyflow/react": "^12.10.2",
    "exceljs": "^4.4.0",
    "html-to-image": "^1.11.13",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^4.3.1",
    "docx": "^9.6.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fallow": "^2.85.0",
    "globals": "^17.11.0",
    "jsdom": "^28.1.0",
    "supabase": "^2.98.1",
    "typescript": "^6.0.3",
    "vite": "^5.4.0",
    "vitest": "^3.2.7"
  }
}
