{
  "name": "@simmodlr/flow-mcp",
  "version": "0.3.0",
  "description": "Local MCP server for Flow (simmodlr DES): lets an AI assistant check, run and save Flow models on your computer.",
  "type": "module",
  "private": true,
  "bin": {
    "flow-mcp": "dist/flow-mcp.mjs"
  },
  "files": [
    "dist/flow-mcp.mjs",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
