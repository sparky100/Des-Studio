{
  "name": "Bike Shop — Hire, Return, Purchase & Repair",
  "model_json": {
    "schemaVersion": 1,
    "entityTypes": [
      {
        "id": "et_hire_job",
        "name": "HireJob",
        "role": "customer",
        "count": 0,
        "attrDefs": [
          {
            "name": "taskPriority",
            "mutable": true,
            "valueType": "number",
            "defaultValue": 2
          }
        ]
      },
      {
        "id": "et_purchase",
        "name": "PurchaseCustomer",
        "role": "customer",
        "count": 0,
        "attrDefs": [
          {
            "name": "taskPriority",
            "mutable": true,
            "valueType": "number",
            "defaultValue": 2
          }
        ]
      },
      {
        "id": "et_repair_job",
        "name": "RepairJob",
        "role": "customer",
        "count": 0,
        "attrDefs": [
          {
            "name": "taskPriority",
            "mutable": true,
            "valueType": "number",
            "defaultValue": 2
          }
        ]
      },
      {
        "id": "et_staff",
        "name": "Staff",
        "role": "server",
        "count": 3,
        "attrDefs": []
      },
      {
        "id": "et_on_hire",
        "name": "OnHire",
        "role": "server",
        "count": 15,
        "attrDefs": []
      },
      {
        "id": "et_time_away",
        "name": "TimeAway",
        "role": "server",
        "count": 100,
        "attrDefs": []
      }
    ],
    "stateVariables": [
      {
        "id": "sv_repairs_in_progress",
        "name": "repairsInProgress",
        "valueType": "number",
        "initialValue": 0,
        "resetOnWarmup": true
      }
    ],
    "bEvents": [
      {
        "id": "b_arrive_hire",
        "name": "Hire Arrival",
        "effect": [
          "ARRIVE(HireJob, Hire Queue)",
          "SET_ATTR(taskPriority, 2)"
        ],
        "schedules": [
          {
            "dist": "Uniform",
            "eventId": "b_arrive_hire",
            "distParams": {
              "max": "240",
              "min": "60"
            }
          }
        ],
        "description": "Generates a hire job arrival (checkout stage)",
        "scheduledTime": "0"
      },
      {
        "id": "b_arrive_purchase",
        "name": "Purchase Arrival",
        "effect": [
          "ARRIVE(PurchaseCustomer, Purchase Queue)",
          "SET_ATTR(taskPriority, 2)"
        ],
        "schedules": [
          {
            "dist": "Exponential",
            "eventId": "b_arrive_purchase",
            "distParams": {
              "mean": "12"
            }
          }
        ],
        "description": "Generates a bike/component purchase customer arrival",
        "scheduledTime": "0"
      },
      {
        "id": "b_arrive_repair_job",
        "name": "Repair Job Arrival",
        "effect": [
          "ARRIVE(RepairJob, Repair Drop-off Queue)",
          "SET_ATTR(taskPriority, 2)"
        ],
        "schedules": [
          {
            "dist": "Exponential",
            "eventId": "b_arrive_repair_job",
            "distParams": {
              "mean": "40"
            }
          }
        ],
        "description": "Generates a repair job arrival (customer drops bike off later)",
        "scheduledTime": "0"
      },
      {
        "id": "b_hire_done",
        "name": "Hire Complete",
        "effect": [
          "RELEASE(Staff, Out On Hire Queue)"
        ],
        "schedules": [],
        "description": "Completes checkout, frees the staff member, and sends the job out on hire",
        "scheduledTime": "9999"
      },
      {
        "id": "b_hire_period_done",
        "name": "Hire Period Ends",
        "effect": [
          "RELEASE(OnHire, Return Queue)"
        ],
        "schedules": [],
        "description": "Fires once the customer's rental period ends; routes the job to the Return Queue for check-in",
        "scheduledTime": "9999"
      },
      {
        "id": "b_return_done",
        "name": "Check-in Complete",
        "effect": [
          "FILL(BikesAvailable, 1)",
          "COMPLETE()"
        ],
        "schedules": [],
        "description": "Completes the check-in transaction, frees the staff member, and returns the bike to the available pool",
        "scheduledTime": "9999"
      },
      {
        "id": "b_purchase_done",
        "name": "Purchase Complete",
        "effect": [
          "COMPLETE()"
        ],
        "schedules": [],
        "description": "Completes a purchase transaction and frees the staff member",
        "scheduledTime": "9999"
      },
      {
        "id": "b_repair_dropoff_done",
        "name": "Repair Drop-off Complete",
        "effect": [
          "RELEASE(Staff, Repair Queue)"
        ],
        "schedules": [],
        "description": "Frees the staff member after hand-over and moves the same job into the Repair Queue for actual repair work",
        "scheduledTime": "9999"
      },
      {
        "id": "b_repair_done",
        "name": "Repair Job Complete",
        "effect": [
          "SET(repairsInProgress, repairsInProgress - 1)",
          "RELEASE(Staff, Travel Queue)"
        ],
        "schedules": [],
        "description": "Completes the repair, frees the staff member, and notifies the customer — the job now waits for them to travel back",
        "scheduledTime": "9999"
      },
      {
        "id": "b_travel_done",
        "name": "Customer Arrives for Pickup",
        "effect": [
          "RELEASE(TimeAway, Pickup Queue)"
        ],
        "schedules": [],
        "description": "Fires once the customer's short post-notification travel delay ends; routes the job to the Pickup Queue",
        "scheduledTime": "9999"
      },
      {
        "id": "b_pickup_done",
        "name": "Pickup Complete",
        "effect": [
          "COMPLETE()"
        ],
        "schedules": [],
        "description": "Completes the pickup hand-over; the job leaves the system",
        "scheduledTime": "9999"
      }
    ],
    "cEvents": [
      {
        "id": "c_preempt_for_hire",
        "name": "Preempt Repair for Hire Customer",
        "effect": [
          "PREEMPT(Staff, PRIORITY(taskPriority))",
          "SET(repairsInProgress, repairsInProgress - 1)"
        ],
        "priority": 0,
        "condition": {
          "operator": "AND",
          "clauses": [
            {
              "variable": "queue(Hire Queue).length",
              "operator": ">",
              "value": 0
            },
            {
              "variable": "idle(Staff).count",
              "operator": "==",
              "value": 0
            },
            {
              "variable": "state.repairsInProgress",
              "operator": ">",
              "value": 0
            }
          ]
        },
        "cSchedules": [],
        "description": "Interrupts an in-progress bike repair when a hire customer is waiting and both staff are busy"
      },
      {
        "id": "c_preempt_for_return",
        "name": "Preempt Repair for Return Customer",
        "effect": [
          "PREEMPT(Staff, PRIORITY(taskPriority))",
          "SET(repairsInProgress, repairsInProgress - 1)"
        ],
        "priority": 0,
        "condition": {
          "operator": "AND",
          "clauses": [
            {
              "variable": "queue(Return Queue).length",
              "operator": ">",
              "value": 0
            },
            {
              "variable": "idle(Staff).count",
              "operator": "==",
              "value": 0
            },
            {
              "variable": "state.repairsInProgress",
              "operator": ">",
              "value": 0
            }
          ]
        },
        "cSchedules": [],
        "description": "Interrupts an in-progress bike repair when a customer is waiting to check a bike back in and both staff are busy"
      },
      {
        "id": "c_preempt_for_purchase",
        "name": "Preempt Repair for Purchase Customer",
        "effect": [
          "PREEMPT(Staff, PRIORITY(taskPriority))",
          "SET(repairsInProgress, repairsInProgress - 1)"
        ],
        "priority": 0,
        "condition": {
          "operator": "AND",
          "clauses": [
            {
              "variable": "queue(Purchase Queue).length",
              "operator": ">",
              "value": 0
            },
            {
              "variable": "idle(Staff).count",
              "operator": "==",
              "value": 0
            },
            {
              "variable": "state.repairsInProgress",
              "operator": ">",
              "value": 0
            }
          ]
        },
        "cSchedules": [],
        "description": "Interrupts an in-progress bike repair when a purchase customer is waiting and both staff are busy"
      },
      {
        "id": "c_preempt_for_repair_dropoff",
        "name": "Preempt Repair for Repair Drop-off Customer",
        "effect": [
          "PREEMPT(Staff, PRIORITY(taskPriority))",
          "SET(repairsInProgress, repairsInProgress - 1)"
        ],
        "priority": 0,
        "condition": {
          "operator": "AND",
          "clauses": [
            {
              "variable": "queue(Repair Drop-off Queue).length",
              "operator": ">",
              "value": 0
            },
            {
              "variable": "idle(Staff).count",
              "operator": "==",
              "value": 0
            },
            {
              "variable": "state.repairsInProgress",
              "operator": ">",
              "value": 0
            }
          ]
        },
        "cSchedules": [],
        "description": "Interrupts an in-progress repair when a repair drop-off customer is waiting and both staff are busy"
      },
      {
        "id": "c_preempt_for_pickup",
        "name": "Preempt Repair for Pickup Customer",
        "effect": [
          "PREEMPT(Staff, PRIORITY(taskPriority))",
          "SET(repairsInProgress, repairsInProgress - 1)"
        ],
        "priority": 0,
        "condition": {
          "operator": "AND",
          "clauses": [
            {
              "variable": "queue(Pickup Queue).length",
              "operator": ">",
              "value": 0
            },
            {
              "variable": "idle(Staff).count",
              "operator": "==",
              "value": 0
            },
            {
              "variable": "state.repairsInProgress",
              "operator": ">",
              "value": 0
            }
          ]
        },
        "cSchedules": [],
        "description": "Interrupts an in-progress repair when a customer is waiting to collect a finished bike and both staff are busy"
      },
      {
        "id": "c_assign_hire",
        "name": "Serve Hire Customer",
        "effect": [
          "ASSIGN(Hire Queue, Staff, BikesAvailable:1)"
        ],
        "priority": 1,
        "condition": {
          "operator": "AND",
          "clauses": [
            {
              "variable": "queue(Hire Queue).length",
              "operator": ">",
              "value": 0
            },
            {
              "variable": "idle(Staff).count",
              "operator": ">",
              "value": 0
            },
            {
              "variable": "container(BikesAvailable).level",
              "operator": ">=",
              "value": 1
            }
          ]
        },
        "cSchedules": [
          {
            "dist": "Triangular",
            "eventId": "b_hire_done",
            "distParams": {
              "max": "8",
              "min": "3",
              "mode": "5"
            },
            "useEntityCtx": true
          }
        ],
        "description": "Seizes an idle staff member for the next waiting hire customer, atomically taking one bike out of the available pool; blocks if no bikes are available"
      },
      {
        "id": "c_assign_out_on_hire",
        "name": "Send Customer Out On Hire",
        "effect": [
          "ASSIGN(Out On Hire Queue, OnHire)"
        ],
        "priority": 2,
        "condition": {
          "operator": "AND",
          "clauses": [
            {
              "variable": "queue(Out On Hire Queue).length",
              "operator": ">",
              "value": 0
            },
            {
              "variable": "idle(OnHire).count",
              "operator": ">",
              "value": 0
            }
          ]
        },
        "cSchedules": [
          {
            "dist": "Uniform",
            "eventId": "b_hire_period_done",
            "distParams": {
              "max": "480",
              "min": "60"
            },
            "useEntityCtx": true
          }
        ],
        "description": "Models the actual rental period — an unlimited-in-practice dummy resource used purely to produce the hire duration (naturally capped near fleet size, since a job can't reach this stage without having drained BikesAvailable)"
      },
      {
        "id": "c_assign_return",
        "name": "Serve Check-in",
        "effect": [
          "ASSIGN(Return Queue, Staff)"
        ],
        "priority": 3,
        "condition": {
          "operator": "AND",
          "clauses": [
            {
              "variable": "queue(Return Queue).length",
              "operator": ">",
              "value": 0
            },
            {
              "variable": "idle(Staff).count",
              "operator": ">",
              "value": 0
            }
          ]
        },
        "cSchedules": [
          {
            "dist": "Triangular",
            "eventId": "b_return_done",
            "distParams": {
              "max": "6",
              "min": "2",
              "mode": "4"
            },
            "useEntityCtx": true
          }
        ],
        "description": "Seizes an idle staff member for the next waiting check-in"
      },
      {
        "id": "c_assign_purchase",
        "name": "Serve Purchase Customer",
        "effect": [
          "ASSIGN(Purchase Queue, Staff)"
        ],
        "priority": 4,
        "condition": {
          "operator": "AND",
          "clauses": [
            {
              "variable": "queue(Purchase Queue).length",
              "operator": ">",
              "value": 0
            },
            {
              "variable": "idle(Staff).count",
              "operator": ">",
              "value": 0
            }
          ]
        },
        "cSchedules": [
          {
            "dist": "Triangular",
            "eventId": "b_purchase_done",
            "distParams": {
              "max": "10",
              "min": "3",
              "mode": "6"
            },
            "useEntityCtx": true
          }
        ],
        "description": "Seizes an idle staff member for the next waiting purchase customer"
      },
      {
        "id": "c_assign_repair_dropoff",
        "name": "Serve Repair Drop-off Customer",
        "effect": [
          "ASSIGN(Repair Drop-off Queue, Staff)"
        ],
        "priority": 5,
        "condition": {
          "operator": "AND",
          "clauses": [
            {
              "variable": "queue(Repair Drop-off Queue).length",
              "operator": ">",
              "value": 0
            },
            {
              "variable": "idle(Staff).count",
              "operator": ">",
              "value": 0
            }
          ]
        },
        "cSchedules": [
          {
            "dist": "Triangular",
            "eventId": "b_repair_dropoff_done",
            "distParams": {
              "max": "5",
              "min": "2",
              "mode": "3"
            },
            "useEntityCtx": true
          }
        ],
        "description": "Seizes an idle staff member for the next waiting repair drop-off customer"
      },
      {
        "id": "c_assign_travel",
        "name": "Send Customer Travelling Back",
        "effect": [
          "ASSIGN(Travel Queue, TimeAway)",
          "SET_ATTR(taskPriority, 2)"
        ],
        "priority": 6,
        "condition": {
          "operator": "AND",
          "clauses": [
            {
              "variable": "queue(Travel Queue).length",
              "operator": ">",
              "value": 0
            },
            {
              "variable": "idle(TimeAway).count",
              "operator": ">",
              "value": 0
            }
          ]
        },
        "cSchedules": [
          {
            "dist": "Uniform",
            "eventId": "b_travel_done",
            "distParams": {
              "max": "90",
              "min": "15"
            },
            "useEntityCtx": true
          }
        ],
        "description": "Models the short delay after notification before the customer physically returns; also restores taskPriority to protected now repair work is over"
      },
      {
        "id": "c_assign_pickup",
        "name": "Serve Pickup",
        "effect": [
          "ASSIGN(Pickup Queue, Staff)"
        ],
        "priority": 7,
        "condition": {
          "operator": "AND",
          "clauses": [
            {
              "variable": "queue(Pickup Queue).length",
              "operator": ">",
              "value": 0
            },
            {
              "variable": "idle(Staff).count",
              "operator": ">",
              "value": 0
            }
          ]
        },
        "cSchedules": [
          {
            "dist": "Triangular",
            "eventId": "b_pickup_done",
            "distParams": {
              "max": "5",
              "min": "2",
              "mode": "3"
            },
            "useEntityCtx": true
          }
        ],
        "description": "Seizes an idle staff member to hand over the finished bike"
      },
      {
        "id": "c_start_repair_work",
        "name": "Start Repair Work",
        "effect": [
          "ASSIGN(Repair Queue, Staff)",
          "SET_ATTR(taskPriority, 1)",
          "SET(repairsInProgress, repairsInProgress + 1)"
        ],
        "priority": 8,
        "condition": {
          "operator": "AND",
          "clauses": [
            {
              "variable": "queue(Repair Queue).length",
              "operator": ">",
              "value": 0
            },
            {
              "variable": "idle(Staff).count",
              "operator": ">",
              "value": 0
            }
          ]
        },
        "cSchedules": [
          {
            "dist": "Lognormal",
            "eventId": "b_repair_done",
            "distParams": {
              "logMean": "3.681",
              "logStdDev": "0.5"
            },
            "useEntityCtx": true
          }
        ],
        "description": "Seizes an idle staff member to actually repair the next waiting job, and marks it preemptable"
      }
